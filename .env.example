# ============ LLM ============
# deepseek | openai | ollama | mock
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL_FAST=deepseek-flash
LLM_MODEL_QUALITY=deepseek-v4-pro

# ============ 数据 ============
# 本地默认 SQLite；生产用 postgresql+psycopg://user:pass@host:5432/agentdesk
DATABASE_URL=sqlite:///./data/agentdesk.db
UPLOAD_DIR=./data/uploads

# ============ 行为开关 ============
# 1 = 无 Key 时使用真实响应快照回放，演示不受网络影响
DEMO_REPLAY=1
# 语义缓存相似度阈值
SEMANTIC_CACHE_THRESHOLD=0.95
# 单次请求 token 预算上限
TOKEN_BUDGET=12000
# PII 脱敏网关
PII_MASK=1

# ============ 服务 ============
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
