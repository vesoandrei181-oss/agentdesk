# ===== 复制为 deploy/.env 后填写，本文件不要直接改 =====

# 站点域名
#   standalone 模式：Caddy 用它自动申请证书，必须已解析到本机公网 IP
#   tunnel 模式：仅用于 CORS 与页面里的地址展示，实际入口由 Cloudflare 隧道配置
SITE_ADDRESS=agentdesk.2007116.xyz

# 模型接入
LLM_PROVIDER=auto
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-在这里填你的key
LLM_MODEL_FAST=deepseek-flash
LLM_MODEL_QUALITY=deepseek-v4-pro

# 安全与成本
PII_MASK=1
SEMANTIC_CACHE_THRESHOLD=0.95
TOKEN_BUDGET=12000
CORS_ORIGINS=https://agentdesk.2007116.xyz
# 登录签名密钥：换成随机串，泄露等于泄露所有登录 token
SECRET_KEY=请换成32位以上随机字符串

# 前端依赖源（境内服务器建议换镜像；仅构建镜像时生效）
# NPM_REGISTRY=https://registry.npmmirror.com
