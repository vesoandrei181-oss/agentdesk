# ===== 复制为 deploy/.env 后填写，本文件不要直接改 =====

# 站点域名（Caddy 用它自动申请证书，必须已经解析到本机公网 IP）
SITE_ADDRESS=durkmo.eu.cc

# 模型接入
LLM_PROVIDER=auto
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-在这里填你的key
LLM_MODEL_FAST=deepseek-flash
LLM_MODEL_QUALITY=deepseek-v4-pro

# 安全与成本
PII_MASK=1
SEMANTIC_CACHE_THRESHOLD=0.95
TOKEN_BUDGET=12000
CORS_ORIGINS=https://durkmo.eu.cc
# 登录签名密钥：换成随机串，泄露等于泄露所有登录 token
SECRET_KEY=请换成32位以上随机字符串
